# Локальный запуск без Docker. Скопируйте в backend/.env — Django прочитает его при старте.
# Файл .env исключён из Git: ключи PayPal храните только в нём.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SECRET_KEY=replace-for-local-use
# Адрес, по которому открыт сайт: ссылки в письмах, возврат из PayPal, ссылки AI-сводки.
TASKCONTROL_FRONTEND_URL=http://127.0.0.1:8080

# PayPal Sandbox (https://developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# AI-помощник: Ollama на этом компьютере
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# TASKCONTROL_AI_MODEL=qwen2.5:3b

# Optional PostgreSQL configuration.
# POSTGRES_DB=taskcontrol
# POSTGRES_USER=taskcontrol
# POSTGRES_PASSWORD=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
