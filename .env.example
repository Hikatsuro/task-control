# Для Docker Compose. Скопируйте в .env:  cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# Для запуска без Docker используйте backend/.env (образец — backend/.env.example).

# --- Django ---
DJANGO_SECRET_KEY=change-me-for-local-demo
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Адрес сайта (должен совпадать с тем, что открыт в браузере) ---
TASKCONTROL_PORT=8080
TASKCONTROL_FRONTEND_URL=http://127.0.0.1:8080

# 1 — при старте заполнить БД вымышленными данными (повторный запуск безопасен)
TASKCONTROL_SEED_DEMO=1

# --- PostgreSQL ---
POSTGRES_DB=taskcontrol
POSTGRES_USER=taskcontrol
POSTGRES_PASSWORD=taskcontrol

# --- PayPal Sandbox (https://developer.paypal.com → Apps & Credentials → Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- AI-помощник: Ollama на этом компьютере (не в контейнере) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
TASKCONTROL_AI_MODEL=qwen2.5:3b
